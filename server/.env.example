# Copy to .env and edit. .env is gitignored.

# HTTP listener — bind to 0.0.0.0 so the Tab5 on LAN can reach it.
PORT=8787

# Bearer token the Tab5 must send on every /api/* request.
# REQUIRED — server refuses to start until this is set to a real value.
# Generate one with: openssl rand -hex 24
AUTH_TOKEN=change-me-set-via-openssl-rand-hex-24

# Weather provider: QWeather (HeFeng).
# Free-text query for the GeoAPI lookup — city name, "lon,lat", or a
# QWeather LocationID directly.
WEATHER_LOCATION=Singapore
# Display label on the device. Falls back to the resolved name if blank.
WEATHER_CITY=Singapore

# QWeather JWT auth. Sign up at https://dev.qweather.com, create a
# project, attach an Ed25519 credential, and copy the values below.
# Your private key signs JWTs locally; the matching public key sits
# in the QWeather console.
QWEATHER_HOST=your-subdomain.re.qweatherapi.com
QWEATHER_PROJECT_ID=your-project-id
QWEATHER_KID=your-credential-kid
# Path to the Ed25519 private key (PKCS#8 PEM). Resolved relative to
# the server's cwd. Generate one with:
#   openssl genpkey -algorithm ed25519 -out ed25519-private.pem
#   openssl pkey -in ed25519-private.pem -pubout -out ed25519-public.pem
QWEATHER_KEY_PATH=../ed25519-private.pem
